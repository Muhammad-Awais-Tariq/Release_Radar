        "messages": {
          "values": [
            {
              "content": "=You are a movie recommendation assistant helping a user decide what upcoming movie to watch.\n\nUser's mood/preference: {{ $json.mood }}\n\nHere is a list of upcoming movie candidates in JSON format:\n{{ JSON.stringify($json.candidates) }}\n\nYour task:\n1. Carefully consider the user's mood/preference. If it's vague or empty, use your best judgement based on the overviews to pick broadly appealing choices.\n2. Select exactly 3 movies from the candidates list that best match the user's mood.\n3. For each selected movie, write a short 1-2 sentence \"reason\" explaining why it fits the user's mood specifically — reference the overview or tone of the movie, not generic praise.\n4. Do NOT invent movies that aren't in the candidates list. Only choose from what was given.\n\nRespond with ONLY a raw JSON array, no markdown code fences, no extra commentary, no explanation outside the JSON. Use exactly this structure:\n\n[\n  {\n    \"title\": \"movie title from candidates\",\n    \"release_date\": \"release date from candidates\",\n    \"overview\": \"overview from candidates\",\n    \"poster_path\": \"poster_path from candidates\",\n    \"reason\": \"why this fits the user's mood\"\n  }\n]"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
