        "text": "={{ \"Find upcoming movies for TMDB genre id \" + $json.genre_id + \". User's mood/preference: '\" + ($('Webhook1').first().json.body.mood || \"no specific preference\") + \"'. Today's date is \" + $today.toFormat('yyyy-MM-dd') + \".\" }}",
